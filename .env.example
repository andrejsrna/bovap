# Fáza 1 – odosielanie cez Brevo
# BREVO_API_KEY=""

# S3 / MinIO – PDF prílohy kampaní
# Interná endpoint URL z BOVAP kontajnera, napr. http://10.0.1.6:9000
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_BUCKET="bovap"
# S3_REGION="us-east-1"
# Verejná URL ROOT konkrétneho bucketu cez reverse proxy, bez koncového /
# napr. https://files.bovap.sk/bovap
# S3_PUBLIC_URL=""
